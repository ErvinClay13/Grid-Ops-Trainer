# --- Secrets ---
# Never commit your API key. This covers .env at the root (backend) and
# any .env inside frontend/ too, just in case Vite ever needs one.
.env
.env.local
frontend/.env
frontend/.env.local

# --- Dependencies ---
# node_modules exists in TWO places in this project: the root (backend)
# and frontend/ (the Vite app). Both need to be ignored separately.
node_modules/
frontend/node_modules/

# --- Build output ---
# Vite's production build folder — gets regenerated by `npm run build`,
# never needs to be committed.
frontend/dist/

# --- Logs ---
*.log
npm-debug.log*

# --- OS / editor clutter ---
.DS_Store
Thumbs.db
.vscode/
# --- Editor local history ---
.history/